{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run GithubCopilotView",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "npm: compile"
    },
    {
      "name": "Attach to Extension Host",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9229,
      "timeout": 30000,
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist/**/*.js"]
    }
  ]
}